# ==================================================
#  再配布できない素材（README の入手先から各自で用意してください）
# ==================================================

# 3Dモデル「止丸式初音ミクNT」（止丸様 / BOOTH）- 再配布禁止
/Assets/*止丸式初音ミクNT*
/Assets/tomarudo/
/Assets/tomarudo.meta

# 3Dモデル「とっと式初音ミクV3」- モーション変換用
/Assets/Animation/Animation/*v3_ver.2.02*

# モーション「ダンスロボットダンス」（ねこがし様）と、そこから変換したアニメーション - 再配布禁止
/Assets/Animation/Animation/DanceRobotDance/
/Assets/Animation/Animation/DanceRobotDance.meta

